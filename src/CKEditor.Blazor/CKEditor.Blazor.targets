<Project>
  <PropertyGroup>
    <!-- CKEditor NPM package configuration - can be overridden in consuming project -->
    <CKEditorVersion Condition="'$(CKEditorVersion)' == ''">47.6.0</CKEditorVersion>
    <CKEditorIncludePremiumAssets Condition="'$(CKEditorIncludePremiumAssets)' == ''">false</CKEditorIncludePremiumAssets>
    <CKBoxVersion Condition="'$(CKBoxVersion)' == ''">2.8.0</CKBoxVersion>
    <CKBoxIncludeAssets Condition="'$(CKBoxIncludeAssets)' == ''">true</CKBoxIncludeAssets>

    <!-- Allow disabling download of core CKEditor assets -->
    <CKEditorIncludeAssets Condition="'$(CKEditorIncludeAssets)' == ''">true</CKEditorIncludeAssets>

    <!-- Default output directory - wwwroot in the consuming project -->
    <CKEditorAssetsOutputPath Condition="'$(CKEditorAssetsOutputPath)' == ''">$(MSBuildProjectDirectory)/wwwroot</CKEditorAssetsOutputPath>

    <!-- Optional custom NPM registry URL -->
    <CKEditorNpmRegistryUrl Condition="'$(CKEditorNpmRegistryUrl)' == ''">https://registry.npmjs.org</CKEditorNpmRegistryUrl>

    <!-- Internal properties -->
    <_CKEditorTempDir>$(BaseIntermediateOutputPath)ckeditor-npm</_CKEditorTempDir>
  </PropertyGroup>

  <!-- Embed CKEditor version into the assembly metadata of the consuming project -->
  <ItemGroup>
    <AssemblyAttribute Include="System.Reflection.AssemblyMetadataAttribute">
      <_Parameter1>CKEditor.Blazor.CKEditorVersion</_Parameter1>
      <_Parameter2>$(CKEditorVersion)</_Parameter2>
    </AssemblyAttribute>
    <AssemblyAttribute Include="System.Reflection.AssemblyMetadataAttribute">
      <_Parameter1>CKEditor.Blazor.CKBoxVersion</_Parameter1>
      <_Parameter2>$(CKBoxVersion)</_Parameter2>
    </AssemblyAttribute>
    <AssemblyAttribute Include="System.Reflection.AssemblyMetadataAttribute">
      <_Parameter1>CKEditor.Blazor.AssetsOutputPath</_Parameter1>
      <_Parameter2>/</_Parameter2>
    </AssemblyAttribute>
    <AssemblyAttribute Include="System.Reflection.AssemblyMetadataAttribute">
      <_Parameter1>CKEditor.Blazor.IncludePremiumAssets</_Parameter1>
      <_Parameter2>$(CKEditorIncludePremiumAssets)</_Parameter2>
    </AssemblyAttribute>
  </ItemGroup>

  <!-- CKEditor NPM Assets Download Target -->
    <Target Name="CKEditorDownloadNpmAssets"
      BeforeTargets="BeforeBuild"
      Condition="'$(CKEditorIncludeAssets)' == 'true' AND !Exists('$(CKEditorAssetsOutputPath)/ckeditor5/$(CKEditorVersion)/dist/browser')">
    <Message Text="Downloading CKEditor $(CKEditorVersion) assets to $(CKEditorAssetsOutputPath) (Premium: $(CKEditorIncludePremiumAssets))..." Importance="high" />

    <!-- Create temp directory -->
    <MakeDir Directories="$(_CKEditorTempDir)" />
    <MakeDir Directories="$(CKEditorAssetsOutputPath)/ckeditor5/$(CKEditorVersion)/dist" />
    <MakeDir Directories="$(CKEditorAssetsOutputPath)/ckeditor5-premium-features/$(CKEditorVersion)/dist" Condition="'$(CKEditorIncludePremiumAssets)' == 'true'" />
    <MakeDir Directories="$(CKEditorAssetsOutputPath)/ckbox/$(CKBoxVersion)/dist" Condition="'$(CKBoxIncludeAssets)' == 'true'" />

    <!-- Download and extract core CKEditor -->
    <DownloadFile SourceUrl="$(CKEditorNpmRegistryUrl)/ckeditor5/-/ckeditor5-$(CKEditorVersion).tgz"
                  DestinationFolder="$(_CKEditorTempDir)"
                  DestinationFileName="core.tgz" />
    <Exec Command="tar -xzf &quot;$(_CKEditorTempDir)/core.tgz&quot; -C &quot;$(_CKEditorTempDir)&quot;" />

    <!-- Copy only dist/browser and dist/translations from core -->
    <ItemGroup>
      <_CKEditorCoreBrowserFiles Include="$(_CKEditorTempDir)/package/dist/browser/**/*.*" />
      <_CKEditorCoreTranslationFiles Include="$(_CKEditorTempDir)/package/dist/translations/**/*.*" />
    </ItemGroup>

    <Copy SourceFiles="@(_CKEditorCoreBrowserFiles)"
          DestinationFiles="@(_CKEditorCoreBrowserFiles->'$(CKEditorAssetsOutputPath)/ckeditor5/$(CKEditorVersion)/dist/browser/%(RecursiveDir)%(Filename)%(Extension)')"
          SkipUnchangedFiles="true" />
    <Copy SourceFiles="@(_CKEditorCoreTranslationFiles)"
          DestinationFiles="@(_CKEditorCoreTranslationFiles->'$(CKEditorAssetsOutputPath)/ckeditor5/$(CKEditorVersion)/dist/translations/%(RecursiveDir)%(Filename)%(Extension)')"
          SkipUnchangedFiles="true" />

    <!-- Download and extract premium features if requested -->
    <DownloadFile SourceUrl="$(CKEditorNpmRegistryUrl)/ckeditor5-premium-features/-/ckeditor5-premium-features-$(CKEditorVersion).tgz"
                  DestinationFolder="$(_CKEditorTempDir)"
                  DestinationFileName="premium.tgz"
                  Condition="'$(CKEditorIncludePremiumAssets)' == 'true'" />
    <Exec Command="tar -xzf &quot;$(_CKEditorTempDir)/premium.tgz&quot; -C &quot;$(_CKEditorTempDir)&quot;"
          Condition="'$(CKEditorIncludePremiumAssets)' == 'true'" />

    <!-- Copy only dist/browser and dist/translations from premium -->
    <ItemGroup Condition="'$(CKEditorIncludePremiumAssets)' == 'true'">
      <_CKEditorPremiumBrowserFiles Include="$(_CKEditorTempDir)/package/dist/browser/**/*.*" />
      <_CKEditorPremiumTranslationFiles Include="$(_CKEditorTempDir)/package/dist/translations/**/*.*" />
    </ItemGroup>

    <Copy SourceFiles="@(_CKEditorPremiumBrowserFiles)"
          DestinationFiles="@(_CKEditorPremiumBrowserFiles->'$(CKEditorAssetsOutputPath)/ckeditor5-premium-features/$(CKEditorVersion)/dist/browser/%(RecursiveDir)%(Filename)%(Extension)')"
          SkipUnchangedFiles="true"
          Condition="'$(CKEditorIncludePremiumAssets)' == 'true'" />
    <Copy SourceFiles="@(_CKEditorPremiumTranslationFiles)"
          DestinationFiles="@(_CKEditorPremiumTranslationFiles->'$(CKEditorAssetsOutputPath)/ckeditor5-premium-features/$(CKEditorVersion)/dist/translations/%(RecursiveDir)%(Filename)%(Extension)')"
          SkipUnchangedFiles="true"
          Condition="'$(CKEditorIncludePremiumAssets)' == 'true'" />

    <!-- Clean up temp files -->
    <RemoveDir Directories="$(_CKEditorTempDir)/package" />
    <Delete Files="$(_CKEditorTempDir)/core.tgz" />
    <Delete Files="$(_CKEditorTempDir)/ckbox.tgz" Condition="'$(CKBoxIncludeAssets)' == 'true'" />

    <Message Text="CKEditor assets downloaded successfully to $(CKEditorAssetsOutputPath)!" Importance="high" />
  </Target>

  <!-- CKBox NPM Assets Download Target -->
  <Target Name="CKBoxDownloadNpmAssets"
          BeforeTargets="BeforeBuild"
          Condition="'$(CKBoxIncludeAssets)' == 'true' AND !Exists('$(CKEditorAssetsOutputPath)/ckbox/$(CKBoxVersion)/dist/ckbox.js')">
    <Message Text="Downloading CKBox $(CKBoxVersion) assets to $(CKEditorAssetsOutputPath)..." Importance="high" />

    <!-- Create temp directory -->
    <MakeDir Directories="$(_CKEditorTempDir)" />
    <MakeDir Directories="$(CKEditorAssetsOutputPath)/ckbox/$(CKBoxVersion)/dist" />

    <!-- Download and extract CKBox -->
    <DownloadFile SourceUrl="$(CKEditorNpmRegistryUrl)/ckbox/-/ckbox-$(CKBoxVersion).tgz"
                  DestinationFolder="$(_CKEditorTempDir)"
                  DestinationFileName="ckbox.tgz" />
    <Exec Command="tar -xzf &quot;$(_CKEditorTempDir)/ckbox.tgz&quot; -C &quot;$(_CKEditorTempDir)&quot;" />

    <!-- Copy dist folder from CKBox (UMD format) -->
    <ItemGroup>
      <_CKBoxDistFiles Include="$(_CKEditorTempDir)/package/dist/**/*.*" />
    </ItemGroup>

    <Copy SourceFiles="@(_CKBoxDistFiles)"
          DestinationFiles="@(_CKBoxDistFiles->'$(CKEditorAssetsOutputPath)/ckbox/$(CKBoxVersion)/dist/%(RecursiveDir)%(Filename)%(Extension)')"
          SkipUnchangedFiles="true" />

    <!-- Clean up temp files -->
    <RemoveDir Directories="$(_CKEditorTempDir)/package" />
    <Delete Files="$(_CKEditorTempDir)/ckbox.tgz" />

    <Message Text="CKBox assets downloaded successfully to $(CKEditorAssetsOutputPath)!" Importance="high" />
  </Target>
</Project>
