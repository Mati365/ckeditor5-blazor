@namespace CKEditor.Blazor.Components

<cke5-editable
    @ref="_elementRef"
    id="@Id"
    class="@Class"
    style="@StyleValue"
    data-cke-editor-id="@ResolvedEditorId"
    data-cke-root-name="@RootName"
    data-cke-root-attributes="@RootAttributesJson"
    data-cke-content="@Value"
    data-cke-save-debounce-ms="@SaveDebounceMs"
    data-cke-interactive="@Interactive">

    <div
        class="@InnerClass"
        style="@InnerStyle"
        data-cke-editable-content>
    </div>

    @if (!string.IsNullOrEmpty(Name))
    {
        <CKE5HiddenInput
            Name="@Name"
            Id="@($"{Id}_input")"
            Required="@Required" />
    }
</cke5-editable>
