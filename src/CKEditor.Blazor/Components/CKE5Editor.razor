@namespace CKEditor.Blazor.Components

<cke5-editor
    @ref="_elementRef"
    class="@Class"
    style="@StyleValue"
    data-cke-editor-id="@Id"
    data-cke-preset="@PresetJson"
    data-cke-content="@ValueJson"
    data-cke-language="@LanguageJson"
    data-cke-save-debounce-ms="@SaveDebounceMs"
    data-cke-interactive="@(Interactive ? "true" : null)"
    data-cke-watchdog="@(Watchdog ? "true" : null)"
    data-cke-editable-height="@EditableHeight"
    data-cke-root-attributes="@RootAttributesJson"
    data-cke-context-id="@(string.IsNullOrEmpty(ResolvedContextId) ? null : ResolvedContextId)">
    @if (ShowInput)
    {
        <div id="@($"{Id}_editor")" data-cke-controlled></div>
    }

    @if (!string.IsNullOrEmpty(Name))
    {
        <CKE5HiddenInput
            Name="@Name"
            Id="@($"{Id}_input")"
            Required="@Required" />
    }

    <CascadingValue Value="this" IsFixed="true">
        @ChildContent
    </CascadingValue>
</cke5-editor>
