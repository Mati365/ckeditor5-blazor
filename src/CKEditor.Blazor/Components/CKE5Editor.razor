@namespace CKEditor.Blazor.Components

<cke5-editor
    @ref="_elementRef"
    class="@Class"
    style="@StyleValue"
    data-cke-editor-id="@Id"
    data-cke-preset="@PresetJson"
    data-cke-content="@ValueJson"
    data-cke-language="@LanguageJson"
    data-cke-save-debounce-ms="@SaveDebounceMs"
    data-cke-interactive="@(Interactive ? "true" : null)"
    data-cke-watchdog="@(Watchdog ? "true" : null)"
    data-cke-context-id="@(string.IsNullOrEmpty(ContextId) ? null : ContextId)"
    data-cke-editable-height="@EditableHeight">

    @if (ShowInput)
    {
        <div id="@($"{Id}_editor")"></div>
    }

    @if (!string.IsNullOrEmpty(Name))
    {
        <CKE5HiddenInput
            Name="@Name"
            Id="@($"{Id}_input")"
            Required="@Required" />
    }

    @ChildContent
</cke5-editor>
