@namespace CKEditor.Blazor.Components

<cke5-context
    @ref="_elementRef"
    data-cke-context-id="@Id"
    data-cke-language="@LanguageJson"
    data-cke-context="@ContextJson"
    data-cke-interactive="@Interactive">
    <CascadingValue Value="this" IsFixed="true">
        @ChildContent
    </CascadingValue>
</cke5-context>
