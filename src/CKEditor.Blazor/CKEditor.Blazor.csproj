<Project Sdk="Microsoft.NET.Sdk.Razor">
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <NpmPackageDir>$(MSBuildProjectDirectory)/../../npm_package</NpmPackageDir>
    <NpmPackageDist>$(NpmPackageDir)/dist</NpmPackageDist>
    <NpmPackageWwwroot>$(MSBuildProjectDirectory)/wwwroot/ckeditor5-blazor</NpmPackageWwwroot>
  </PropertyGroup>

  <ItemGroup>
    <SupportedPlatform Include="browser" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Components.Web" Version="8.0.23" />
    <PackageReference Include="StyleCop.Analyzers" Version="1.2.0-beta.556">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>

  <!-- 
    Note: NPM package build and copy is handled by the watch-dist.mjs script when running 'pnpm run dev'.
    This prevents race conditions when multiple projects build simultaneously.
    For production builds, run 'pnpm run npm_package:build' before dotnet build.
  -->
</Project>
