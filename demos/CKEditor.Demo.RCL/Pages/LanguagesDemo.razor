@page "/languages"
@using CKEditor.Blazor.Components
@using CKEditor.Blazor.Model
@rendermode InteractiveServer

<div class="mx-auto p-8 max-w-4xl">
    <a href="/" class="inline-block mb-6 text-blue-600 hover:text-blue-800 hover:underline">&larr; Back to home</a>
    <h1 class="mb-6 font-bold text-3xl">Languages &amp; Translations</h1>

    <h2 class="mb-2 font-semibold text-xl">Localized Editor (Polish)</h2>
    <p class="mb-4 text-gray-500">
        The <code class="bg-gray-100 px-1 rounded text-sm">Language</code> parameter sets the UI language.
        Toolbar buttons and menus will be rendered in Polish.
    </p>
    <CKE5Editor
        Language="@("pl")"
        Value="@("<p>Ten edytor jest skonfigurowany w języku polskim.</p>")" />

    <hr class="my-8 border-gray-200" />

    <h2 class="mb-2 font-semibold text-xl">Custom Translations</h2>
    <p class="mb-4 text-gray-500">
        Use <code class="bg-gray-100 px-1 rounded text-sm">CustomTranslations</code> to override specific UI strings per language.
        Here, the <strong>Bold</strong> tooltip is replaced with <em>"BOLDIFY!"</em> and <strong>Italic</strong> with <em>"SLANT!"</em> for the English locale.
    </p>
    <CKE5Editor
        CustomTranslations="@customTranslations"
        Value="@("<p>Hover over the Bold and Italic toolbar buttons to see the custom tooltips.</p>")" />

    <hr class="my-8 border-gray-200" />

    <h2 class="mb-2 font-semibold text-xl">RTL Content (Arabic)</h2>
    <p class="mb-4 text-gray-500">
        Pass a <code class="bg-gray-100 px-1 rounded text-sm">Language</code> object to control
        the UI and content directions independently. This example sets both to Arabic with right-to-left layout.
    </p>
    <CKE5Editor
        Language="@(new Language { UI = "ar", Content = "ar" })"
        Value="@("<p dir=\"rtl\">هذا المحرر مُهيَّأ باللغة العربية مع دعم الاتجاه من اليمين إلى اليسار.</p>")" />
</div>

@code {
    private EditorTranslations customTranslations = new()
    {
        ["en"] = new Dictionary<string, string>
        {
            { "Bold", "BOLDIFY!" },
            { "Italic", "SLANT!" }
        }
    };
}
