
@page "/form"
@using CKEditor.Blazor.Components
@using CKEditor.Blazor.Domain.Model
@using Microsoft.AspNetCore.Components.Forms
@rendermode InteractiveServer

<div class="mx-auto p-8 max-w-4xl">
    <a href="/" class="inline-block mb-6 text-blue-600 hover:text-blue-800 hover:underline">&larr; Back to home</a>
    <h1 class="mb-6 font-bold text-3xl">Form Editor Demo</h1>

    <EditForm Model="@formModel" OnValidSubmit="HandleValidSubmit">
        <Editor @bind-Value="formModel.Content" />
        <button type="submit" class="bg-blue-600 mt-4 px-4 py-2 rounded text-white">Submit</button>
    </EditForm>

    @if (submitted)
    {
        <div class="bg-green-100 mt-4 p-4 border border-green-300 rounded">
            <strong>Submitted content:</strong>
            <div>@formModel.Content.Data["main"]</div>
        </div>
    }
</div>

@code {
    private FormModel formModel = new FormModel();
    private bool submitted;

    private void HandleValidSubmit()
    {
        submitted = true;
    }

    public class FormModel
    {
        public EditorValue Content { get; set; } = new EditorValue("Initial Value");
    }
}
