
@page "/multiroot"
@using CKEditor.Blazor.Components
@rendermode InteractiveServer

<div class="mx-auto p-8 max-w-4xl">
    <a href="/" class="inline-block mb-6 text-blue-600 hover:text-blue-800 hover:underline">&larr; Back to home</a>
    <h1 class="mb-6 font-bold text-3xl">Multiroot Editor Demo</h1>

    <UIPart Name="toolbar" Class="mt-4 mb-6" />

    <div class="gap-4 grid grid-cols-2">
        <div>
            <h2 class="mb-2 font-bold">Header</h2>
            <Editable
                RootName="header"
                Value="Header content"
                Class="border border-gray-300 rounded-sm" />
        </div>
        <div>
            <h2 class="mb-2 font-bold">Content</h2>
            <Editable
                RootName="content"
                Value="Main content"
                Class="border border-gray-300 rounded-sm" />
        </div>
    </div>

    <div class="mt-6">
        <h2 class="mb-2 font-bold">Footer</h2>
        <Editable
            RootName="footer"
            Value="Footer content"
            Class="border border-gray-300 rounded-sm" />
    </div>

    <Editor EditorType="multiroot" />
</div>
