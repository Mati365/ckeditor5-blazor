@page "/multiroot"
@using System.Text.Json
@rendermode InteractiveServer

<div class="mx-auto p-8 max-w-4xl text-gray-900">
    <a href="/" class="inline-block mb-6 text-blue-600 hover:text-blue-800 hover:underline">&larr; Back to home</a>
    <h1 class="mb-6 font-bold text-3xl">Multi-root Editor Demo</h1>

    <div class="flex sm:flex-row flex-col gap-2 mb-8">
        <input
            type="text"
            placeholder="Enter root ID (e.g. sidebar)"
            class="flex-1 p-2 border border-gray-300 rounded-none focus:outline-none focus:ring-1 focus:ring-blue-600"
            @bind="newRootName"
            @bind:event="oninput" />
        <button
            type="button"
            class="bg-blue-600 hover:bg-blue-700 px-6 py-2 rounded-none font-bold text-white transition-colors"
            @onclick="AddRoot">
            Add Root
        </button>
        <button
            type="button"
            class="hover:bg-red-50 px-6 py-2 border border-red-600 rounded-none font-bold text-red-600 transition-colors"
            @onclick="ClearValues">
            Clear Values
        </button>
    </div>

    <CKE5Editor Id="@EditorId" EditorType="multiroot" OnChange="OnEditorChange" />
    <CKE5UIPart Name="toolbar" EditorId="@EditorId" Class="mb-6" />

    <div class="flex flex-col gap-6">
        @foreach (var root in Roots)
        {
            <div @key="root.Name" class="bg-white border border-gray-300" id="@($"container-{root.Name}")">
                <div class="flex justify-between items-center bg-gray-50 p-2 border-gray-300 border-b">
                    <span class="font-mono font-bold text-gray-600 text-xs uppercase">
                        Root ID: @root.Name
                    </span>
                    <button
                        type="button"
                        class="hover:bg-red-50 px-2 py-1 border border-red-600 rounded-none font-bold text-red-600 text-xs transition-colors"
                        @onclick="() => RemoveRoot(root.Name)">
                        Remove
                    </button>
                </div>
                <div class="p-2">
                    <CKE5Editable
                        @bind-Value="@root.Value"
                        RootName="@root.Name"
                        EditorId="@EditorId"
                        OnChange="@(OnRootChange)"
                        Class="focus:outline-none" />
                    <p class="mt-1 text-gray-400 text-xs">@root.Value</p>
                </div>
            </div>
        }

        @if (!string.IsNullOrEmpty(lastEditorChange))
        {
            <div class="bg-yellow-50 p-4 border border-yellow-200">
                <strong class="block mb-1">Last editor OnChange payload:</strong>
                <pre class="font-mono text-sm whitespace-pre-wrap">@lastEditorChange</pre>
            </div>
        }

        @if (!string.IsNullOrEmpty(lastRootChange))
        {
            <div class="bg-green-50 p-2 border border-green-200">
                <strong class="block mb-1">Last root OnChange:</strong> @lastRootChange
            </div>
        }
    </div>
</div>

@code {
    private record EditorRoot(string Name)
    {
        public string Value { get; set; } = string.Empty;
    }

    private string EditorId { get; } = $"cke5-multiroot-{Guid.NewGuid():N}";
    private string? lastEditorChange;
    private string? lastRootChange;

    private List<EditorRoot> Roots { get; } =
    [
        new("header") { Value = "Header content" },
        new("content") { Value = "Main content" },
        new("footer") { Value = "Footer content" },
    ];

    private string? newRootName;

    private void AddRoot()
    {
        var name = string.IsNullOrWhiteSpace(newRootName)
            ? $"r_{Guid.NewGuid():N}"
            : newRootName!.Trim();

        if (Roots.All(r => r.Name != name))
        {
            Roots.Add(new EditorRoot(name) { Value = $"Content for {name}" });
        }

        newRootName = string.Empty;
    }

    private void RemoveRoot(string name)
    {
        Roots.RemoveAll(r => r.Name == name);
    }

    private void ClearValues()
    {
        foreach (var root in Roots)
        {
            root.Value = string.Empty;
        }
    }

    private void OnEditorChange(CKE5EditorChangeEventArgs args)
    {
        lastEditorChange = JsonSerializer.Serialize(args.Value, new JsonSerializerOptions { WriteIndented = true });
    }

    private void OnRootChange(CKE5EditableChangeEventArgs args)
    {
        lastRootChange = $"{args.RootName}: {args.Value}";
    }
}
