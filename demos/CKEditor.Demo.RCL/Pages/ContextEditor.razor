@page "/context"
@using CKEditor.Blazor.Components
@rendermode InteractiveServer

<div class="mx-auto p-8 max-w-4xl">
    <a href="/" class="inline-block mb-6 text-blue-600 hover:text-blue-800 hover:underline">&larr; Back to home</a>
    <h1 class="mb-6 font-bold text-3xl">Context (Multiple Editors) Demo</h1>

    <Context Id="shared-context">
        <div class="gap-6 grid grid-cols-1 md:grid-cols-2">
            <div class="bg-white p-4 border border-gray-200 rounded-lg">
                <h2 class="mb-2 font-bold">Editor 1</h2>
                <Editor ContextId="shared-context" Value="@("Editor 1 content")" />
            </div>
            <div class="bg-white p-4 border border-gray-200 rounded-lg">
                <h2 class="mb-2 font-bold">Editor 2</h2>
                <Editor ContextId="shared-context" Value="@("Editor 2 content")" />
            </div>
        </div>
    </Context>
</div>
